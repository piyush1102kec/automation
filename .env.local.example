# ── Existing PostPilot vars ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
SERPAPI_KEY=...
WEBHOOK_SECRET=change-me-random
NEXT_PUBLIC_APP_NAME=PostPilot

# ── n8n Automation Builder (POC) ──────────────────────────────────────────────
# Your n8n instance base URL (cloud or self-hosted)
# Cloud example:      https://your-name.app.n8n.cloud
# Self-hosted example: http://localhost:5678
N8N_BASE_URL=https://your-name.app.n8n.cloud

# n8n API key — create at: n8n Settings → API → Create API key
N8N_API_KEY=n8n_api_...
